# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Firebase Cloud Messaging (push notifications)
# Project Settings → Cloud Messaging → Server key
FCM_SERVER_KEY=

# Telegram
# 1. Message @BotFather → /newbot → copy the token here
# 2. Users add their chat_id in the app (Sources → Link Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CogniOSBot

# App
SECRET_KEY=change-me-to-a-random-string
ENVIRONMENT=development

# Demo mode — set to "true" to skip live API calls and serve cached briefing
DEMO_MODE=false
